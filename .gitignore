# 제주 여행 도우미 - .gitignore

# 1. 백업 및 복구 파일 (민감 정보 포함 가능성)
*_recovered.js
*~
*.bak
*.tmp

# 2. 로컬 개발 환경 제어
.DS_Store
Thumbs.db

# 3. 환경 변수 및 자격증명 (배포 시 Worker Secret 권장 — 절대 커밋 금지)
.env
.env.*
.dev.vars
.dev.vars.*
secret.json
# Firebase / Google 서비스 계정 키
*adminsdk*.json
*service-account*.json
*-key.json

# 3-1. 로컬 테스트 스크립트 (자격증명 인라인 위험)
scratch/

# 4. 의존성 및 용량 최적화
node_modules/
package-lock.json
dist/
.wrangler/

# 5. 디버그 및 임시 스크립트 (자동화 작업 중 생성됨)
debug_*
inspect_page.js
test_api.py
execution/debug_crawl.png
execution/debug/

# 7. 임시 작업 폴더 및 파일 (항상 재생성 가능)
.tmp/
tmp/
deprecated/
temp.json
test_gas.js
wrangler_err.txt
wrangler_logs.txt

# 6. 에셋 (특정 파일 허용)
*.webp
*.png
!public/assets/*.png
!public/assets/*.webp
!public/img/*.png
.vercel
