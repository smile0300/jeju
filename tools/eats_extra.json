{
  "숙성도 제주본점": {"rv":{"zh":"带动济州黑猪热潮的熟成肉品牌本店，水熟成+干式熟成双重工艺","en":"Flagship of the brand behind Jeju's aged black-pork boom — water- and dry-aged pork","ko":"워터·드라이 교차 숙성으로 흑돼지 열풍을 이끈 브랜드 본점"},"img":"8f89bd1f26d5.webp","imgBy":"Google Maps"},
  "숙성도 중문점": {"rv":{"zh":"中文区人气熟成黑猪，肉汁丰富，游客满意度极高","en":"Jungmun branch of the famous aged black-pork chain, very high visitor satisfaction","ko":"중문의 교차 숙성 흑돼지, 여행객 만족도 최상위권"},"img":"01095155ec91.webp","imgBy":"Google Maps"},
  "숙성도 함덕점": {"rv":{"zh":"咸德海边的熟成黑猪名店，店员帮忙烤肉","en":"Aged black pork near Hamdeok beach, grilled for you by staff","ko":"함덕 바다 근처 숙성 흑돼지, 직원이 직접 구워줌"}},
  "고집돌우럭 제주함덕점": {"rv":{"zh":"招牌红烧许氏平鲉＋烤方头鱼套餐，分量和颜值都很能打","en":"Signature braised rockfish and grilled tilefish set — big, photogenic spread","ko":"활우럭조림·옥돔구이 한상, 비주얼과 맛 모두 압도적"},"img":"9d3f9069bbec.webp","imgBy":"Google Maps"},
  "고집돌우럭 제주공항점": {"rv":{"zh":"机场附近评价最多的海鲜店之一，甜辣红烧许氏平鲉","en":"One of the most-reviewed seafood spots near the airport — sweet-spicy braised rockfish","ko":"공항 근처 해산물 식당 중 리뷰·인지도 최상위"},"img":"3f882dbc7340.webp","imgBy":"Google Maps"},
  "중문수두리보말칼국수": {"rv":{"zh":"满满野生海螺熬汤的手擀面，开门前就排队","en":"Hand-cut noodles in a rich wild sea-snail broth — queues before opening","ko":"자연산 보말 듬뿍 진한 국물, 오픈 전부터 줄 서는 곳"}},
  "금돈가 제주 애월해안도로 본점": {"rv":{"zh":"橡木烟熏直火熟成黑猪，专业烤肉师代烤","en":"Oak-smoked, fire-grilled aged black pork cooked by a pro griller","ko":"참나무 훈연 직화 숙성 흑돼지, 전문 그릴러가 구워줌"},"img":"696b627f896c.webp","imgBy":"Google Maps"},
  "제주광해 애월": {"rv":{"zh":"涯月海景落地窗＋加了鲍鱼、甜虾的红烧带鱼套餐","en":"Ocean-view windows in Aewol and a braised hairtail set with abalone and shrimp","ko":"애월 통창 오션뷰, 전복·딱새우 들어간 갈치조림 세트"},"img":"dd079d6a235d.webp","imgBy":"Google Maps"},
  "미영이네식당": {"rv":{"zh":"摹瑟浦港的青花鱼生鱼片名店，完全不腥，队伍不断","en":"Mosulpo's top raw-mackerel spot — no fishy taste, always a line","ko":"모슬포 고등어회 명소, 비린 맛 없이 찰져서 대기 필수"}},
  "풍원": {"rv":{"zh":"牛岛人气No.1，店员现场做「汉拿山炒饭」火山表演","en":"Udo's best-known spot, with a 'Hallasan fried rice' volcano show at your table","ko":"우도 최고 인지도, 계란 치즈 '한라산볶음밥' 퍼포먼스"},"img":"f2d627d8d6ec.webp","imgBy":"Google Maps"},
  "뽈살집한림점": {"rv":{"zh":"黑猪特殊部位拼盘，摆成花朵造型","en":"Rare black-pork cuts served as a flower-shaped platter","ko":"뽈살·천겹살 등 특수부위 모둠을 꽃 모양으로 담아줌"}},
  "해왓": {"rv":{"zh":"城山的海鲜名店，红烧带鱼和生鱼汤口味清爽不刺激","en":"Seongsan seafood favorite — clean-tasting braised hairtail and cold raw-fish soup","ko":"자극적이지 않은 갈치조림·물회, 도민·여행객 모두 평점 높음"},"img":"addb00cc360a.webp","imgBy":"Google Maps"},
  "한아름식당": {"rv":{"zh":"政府认证「平价良心店」，本地人常去的烤鲜肉","en":"Government-certified fair-price shop; a locals' pick for fresh-grilled pork","ko":"2025 베스트 착한가격업소, 도민 가성비 생고기 단골집"}},
  "만족한상회 중문점": {"rv":{"zh":"店员帮你把整条烤带鱼剔好刺，带孩子或外国人吃也方便","en":"Staff debone the whole grilled hairtail for you — easy for kids and visitors","ko":"통갈치구이 가시를 직원이 발라줘서 아이·외국인도 편함"},"img":"806e0bdf52b0.webp","imgBy":"Google Maps"},
  "낭뜰에쉼팡": {"rv":{"zh":"官方乡土美食店，平价健康的包饭和紫苏面片汤","en":"Official local-food restaurant — healthy wraps and perilla sujebi at fair prices","ko":"공식 향토음식점, 착한 가격 쌈밥과 들깨수제비"}},
  "글라글라하와이": {"rv":{"zh":"用济州海鲜做的夏威夷风小酒馆，很受年轻游客欢迎","en":"Hawaiian-style pub cooking local Jeju fish and shrimp — popular with young travelers","ko":"제주 달고기·딱새우를 하와이안 펍 스타일로, 젊은 여행객 인기"},"img":"d624cca1ca60.webp","imgBy":"Google Maps"},
  "함덕골목 본점": {"rv":{"zh":"早上7点开门的解酒汤老店，本地人早餐首选","en":"Hangover-soup institution opening at 7am — locals' breakfast go-to","ko":"아침 7시 오픈, 도민 아침 식사 성지인 내장탕·해장국"}},
  "성읍탐라식당": {"rv":{"zh":"城邑民俗村里20多年的官方乡土美食店，蕨菜炒黑猪","en":"20-year-old official local-food spot in Seongeup — bracken and spicy pork","ko":"20년 넘은 성읍 공식 향토음식점, 고사리 돼지주물럭"}},
  "맛나식당": {"rv":{"zh":"性价比超高的红烧带鱼老店，味道浓郁","en":"Old-school braised hairtail spot with deep flavor and great value","ko":"극강의 가성비, 깊은 감칠맛의 갈치조림 노포"}},
  "노라바": {"rv":{"zh":"整只花蟹、鲍鱼、章鱼的海鲜拉面，看着涯月海边吃","en":"Seafood ramyeon loaded with crab, abalone and octopus, by the Aewol sea","ko":"통꽃게·전복·문어 해물라면을 애월 바다 보며"},"img":"1293a13b096b.webp","imgBy":"Google Maps"},
  "교래흑돼지 본점": {"rv":{"zh":"厚切熟成黑猪炭火现烤，逛完生态乐园·思连伊林荫路顺路吃","en":"Thick aged black pork on charcoal — handy after Eco Land or Saryeoni forest","ko":"두툼한 숙성 흑돼지 참숯구이, 에코랜드·사려니 뒤 동선 좋음"},"img":"1940492df737.webp","imgBy":"Google Maps"},
  "동복해녀식당 구좌본점": {"rv":{"zh":"海女渔村里的官方乡土美食店，生鱼片拌面和冷鱼汤","en":"Official local-food spot in a haenyeo village — raw-fish noodles and mulhoe","ko":"동복리 어촌마을 공식 향토음식점, 회국수·물회"}},
  "곰막식당": {"rv":{"zh":"自家活鱼水槽，看海吃新鲜青花鱼生鱼片和海胆面","en":"Own live tanks — fresh mackerel sashimi and sea-urchin noodles with a sea view","ko":"자체 수족관, 바다 보며 고등어회·성게국수"}},
